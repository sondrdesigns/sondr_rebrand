{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/navigation/**",
              "components/scrapbook/**",
              "components/typography/**",
              "ui_kits/sondr-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Intel One Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Intel One Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|as|href|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, as, href, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|sticky)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'sticky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padded|lift|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padded, lift, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|variant|color|length|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: orientation, variant, color, length, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Divider> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|dashed)$/]",
        "message": "<Divider> variant must be one of 'solid' | 'dashed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DottedGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|margin|paper|style|key|ref|className|style|children)$/]",
        "message": "<DottedGrid> doesn't accept that prop. Declared props: children, margin, paper, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|multiline|rows|value|onChange|type|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, placeholder, multiline, rows, value, onChange, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlipPolaroid'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|caption|title|meta|notes|tilt|width|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<FlipPolaroid> doesn't accept that prop. Declared props: src, caption, title, meta, notes, tilt, width, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|as|color|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: children, level, as, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:display|title|heading)$/]",
        "message": "<Heading> level must be one of 'display' | 'title' | 'heading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|size|muted|style|key|ref|className|style|children)$/]",
        "message": "<MonoText> doesn't accept that prop. Declared props: children, as, size, muted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lead|body|small)$/]",
        "message": "<MonoText> size must be one of 'lead' | 'body' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|current|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: children, href, current, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PolaroidCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|caption|tilt|width|assetBase|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PolaroidCard> doesn't accept that prop. Declared props: src, caption, tilt, width, assetBase, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SondrIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|style|key|ref|className|style|children)$/]",
        "message": "<SondrIcon> doesn't accept that prop. Declared props: name, size, stroke, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SondrIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:works|blog|contact|studio|interior)$/]",
        "message": "<SondrIcon> name must be one of 'works' | 'blog' | 'contact' | 'studio' | 'interior'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tilt|color|size|style|key|ref|className|style|children)$/]",
        "message": "<StickyNote> doesn't accept that prop. Declared props: children, tilt, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tape'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|width|tilt|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Tape> doesn't accept that prop. Declared props: color, width, tilt, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tape'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|cream)$/]",
        "message": "<Tape> color must be one of 'blue' | 'cream'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
